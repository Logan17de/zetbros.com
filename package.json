{
  "name": "zetbros-com",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm --prefix quako run build -- --base=/quako/ --outDir ../out/quako",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "node --test cloudflare/worker.test.mjs",
    "deploy": "npm run build && wrangler deploy",
    "preview": "wrangler dev",
    "prebuild": "npm --prefix quako ci --no-audit --no-fund"
  },
  "dependencies": {
    "next": "15.5.24",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260921.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2",
    "wrangler": "4.135.0"
  }
}
